    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "# 1. The Data (X = Input, y = Output)\n",
    "# ML models expect 'X' to be a Matrix (2D table) and 'y' to be a Vector (1D list)\n",
    "data = {\n",
    "    'Size_SqFt': [1000, 1500, 2000, 2500, 3000],\n",
    "    'Price_USD': [200000, 300000, 400000, 500000, 600000]\n",
    "}\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Features (Input) - Must be 2D DataFrame [[...]]\n",
    "X = df[['Size_SqFt']] \n",
    "# Target (Output) - Can be 1D Series [...]\n",
    "y = df['Price_USD']\n",
    "\n",
    "# 2. The Training (The \"Learning\" Phase)\n",
    "# We create an empty model...\n",
    "model = LinearRegression()\n",
    "# ...and force it to learn the pattern (Size -> Price)\n",
    "model.fit(X, y)\n",
    "\n",
    "print(\"Model Trained Successfully!\")\n",
    "\n",
    "# 3. The Prediction (Using the Brain)\n",
    "# Let's predict the price of a house that is 1800 SqFt (The model has never seen this number)\n",
    "new_house = np.array([[1800]])\n",
    "prediction = model.predict(new_house)\n",
    "\n",
    "print(f\"Prediction for 1800 SqFt house: ${prediction[0]:,.2f}\")\n",
    "\n",
    "# 4. Visualization (Seeing the Brain)\n",
    "plt.scatter(X, y, color='blue', label='Actual Data')\n",
    "plt.plot(X, model.predict(X), color='red', label='Prediction Line')\n",
    "plt.scatter(new_house, prediction, color='green', s=150, label='New Prediction')\n",
    "plt.xlabel('Size (SqFt)')\n",
    "plt.ylabel('Price ($)')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
